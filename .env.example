# 复制为 .env 并填写。未配置短信服务时仅打印通知；全新数据默认暂停自动预约，需在后台明确恢复。

# ---- 基础 ----
PORT=8777
HOST=127.0.0.1
BASE_URL=http://localhost:8777
ADMIN_TOKEN=
# 用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成独立令牌

# ---- 短信转发注入验证码（情况 B：验证码收在运营自己控制的设备/号池上）----
# 填一个长随机串即启用 POST /api/ingest/sms；留空则该接口关闭（返回 503）。
# 收码安卓机的短信转发 App（如 SmsForwarder）用它作为令牌，把官网验证码短信 POST 过来自动确认。
SMS_INGEST_TOKEN=

# ---- 短信（阿里云）----
# SMS_PROVIDER=aliyun 且填齐密钥即启用；否则控制台打印
SMS_PROVIDER=
ALIYUN_SMS_KEY_ID=
ALIYUN_SMS_KEY_SECRET=
ALIYUN_SMS_SIGN=
ALIYUN_SMS_TPL_SUBMITTED=SMS_000000001
ALIYUN_SMS_TPL_SUCCESS=SMS_000000002
ALIYUN_SMS_TPL_CODE=SMS_000000003
